{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run closebooks*)",
      "Bash(uv run python -m closebooks*)",
      "Bash(uv sync*)",
      "Bash(uv pip list*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git worktree list*)",
      "Read(data/**)",
      "Read(out/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)"
    ],
    "ask": [
      "Bash(uv run closebooks submit*)",
      "Bash(*closebooks submit*)"
    ]
  },
  "env": {
    "PYTHONUTF8": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet python \"$CLAUDE_PROJECT_DIR/.claude/hooks/ruff_format.py\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "ruff format"
          }
        ]
      }
    ]
  }
}
